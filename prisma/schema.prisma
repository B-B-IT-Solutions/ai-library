generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Promt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  content          String   @db.Text
  categories       String[]
  recommendedModel String   @map("recommended_model")

  @@map("prompt")
}
