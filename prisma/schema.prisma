generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @default("NO_NAME") @db.VarChar(250)
  email         String         @unique(map: "user_email_idx") @db.VarChar(250)
  emailVerified DateTime?      @map("email_verified") @db.Timestamp(6)
  image         String?
  password      String?        @db.VarChar(250)
  role          String         @default("user") @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]
  carts         Cart[]
  orders        Order[]
  libraries     LibraryEntry[]

  @@map("user")
}

model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(250)
  provider          String  @db.VarChar(500)
  providerAccountId String  @map("provider_account_id") @db.VarChar(500)
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type") @db.VarChar(250)
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

model PromptDescriptor {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String           @db.VarChar(500)
  content          String           @db.Text
  categories       PromptCategory[]
  recommendedModel String           @map("recommended_model") @db.VarChar(250)
  isFavorite       Boolean          @default(false) @map("is_favorite")
  currentVersion   Int              @default(1) @map("current_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime         @updatedAt @map("updated_at")
  prompt           Prompt?
  versions         PromptVersion[]
  followUpPrompts  PromptFollowUp[]

  @@map("prompt_descriptor")
}

model Prompt {
  id         String           @id @db.Uuid
  content    String           @db.Text
  descriptor PromptDescriptor @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("prompt")
}

model PromptCategory {
  id      Int                @id @default(autoincrement())
  name    String             @unique @db.VarChar(250)
  prompts PromptDescriptor[]

  @@map("prompt_category")
}

model PromptVersion {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId  String           @map("prompt_id") @db.Uuid
  version   Int
  content   String           @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  prompt    PromptDescriptor @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_version")
}

model PromptFollowUp {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId  String           @map("prompt_id") @db.Uuid
  content   String           @db.Text
  order     Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  prompt    PromptDescriptor @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("prompt_follow_up")
}

model PromptTemplateDescriptor {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String                   @db.VarChar(250)
  description      String                   @db.VarChar(750)
  categories       PromptTemplateCategory[]
  recommendedModel String                   @map("recommended_model") @db.VarChar(250)
  promptTemplateId String                   @unique @map("prompt_template_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  promptTemplate PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  productItems   ProductItem[]
  libraries      LibraryEntry[]

  @@map("prompt_template_descriptor")
}

model PromptTemplate {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  detailedDescription String   @map("detailed_description") @db.Text
  promptText          String   @map("prompt_text") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @map("updated_at")

  promptTemplateDescriptor PromptTemplateDescriptor?

  @@map("prompt_template")
}

model PromptTemplateCategory {
  id        Int                        @id @default(autoincrement())
  name      String                     @unique @db.VarChar(250)
  templates PromptTemplateDescriptor[]

  @@map("prompt_template_category")
}

// E-Commerce Models

enum ProductType {
  TEMPLATE
  BUNDLE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Product {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String               @db.VarChar(250)
  description    String               @db.Text
  price          Decimal              @db.Decimal(10, 2)
  discountAmount Decimal?             @map("discount_amount") @db.Decimal(10, 2)
  type           ProductType
  status         ProductStatus        @default(ACTIVE)
  features       ProductFeature[]
  useCases       ProductUseCase[]
  examples       ProductExample[]
  instructions   ProductInstruction[]
  productItems   ProductItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @map("updated_at")
  libraries      LibraryEntry[]

  @@map("product")
}

model ProductFeature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  icon        String   @db.VarChar(50)
  title       String   @db.VarChar(250)
  description String   @db.VarChar(750)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_feature")
}

model ProductUseCase {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  category    String   @db.VarChar(250)
  description String   @db.VarChar(750)
  tags        String[] @db.VarChar(100)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_use_case")
}

model ProductExample {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  title     String   @db.VarChar(250)
  content   String   @db.VarChar(750)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_example")
}

model ProductInstruction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  step        Int
  title       String   @db.VarChar(250)
  description String   @db.VarChar(750)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_instruction")
}

model ProductItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product  Product                  @relation(fields: [productId], references: [id])
  template PromptTemplateDescriptor @relation(fields: [templateId], references: [id])

  @@unique([productId, templateId])
  @@map("product_item")
}

model Cart {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  sessionCartId String?    @unique @map("session_cart_id") @db.VarChar(250)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @map("updated_at")
  items         CartItem[]
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart")
}

model CartItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId             String      @map("cart_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productName        String      @map("product_name") @db.VarChar(250)
  productDescription String?     @map("product_description") @db.VarChar(500)
  productType        ProductType @map("product_type")
  productPrice       Decimal     @map("product_price") @db.Decimal(10, 2)
  quantity           Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime    @updatedAt @map("updated_at")
  product            Product     @relation(fields: [productId], references: [id])
  cart               Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_item")
}

model Order {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String         @map("user_id") @db.Uuid
  status                  OrderStatus    @default(PENDING)
  totalAmount             Decimal        @map("total_amount") @db.Decimal(10, 2)
  paymentMethod           String?        @map("payment_method") @db.VarChar(100)
  stripeCheckoutSessionId String?        @unique @map("stripe_checkout_session_id") @db.VarChar(500)
  stripePaymentIntentId   String?        @map("stripe_payment_intent_id") @db.VarChar(500)
  stripePaymentStatus     String?        @map("stripe_payment_status") @db.VarChar(50)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime       @updatedAt @map("updated_at")
  user                    User           @relation(fields: [userId], references: [id])
  items                   OrderItem[]
  libraries               LibraryEntry[]

  @@map("order")
}

model OrderItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String      @map("order_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productName        String      @map("product_name") @db.VarChar(250)
  productDescription String?     @map("product_description") @db.VarChar(500)
  productType        ProductType @map("product_type")
  quantity           Int         @default(1)
  price              Decimal     @db.Decimal(10, 2)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [productId], references: [id])

  @@map("order_item")
}

model LibraryEntry {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  templateDescriptorId String   @map("template_descriptor_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user               User                     @relation(fields: [userId], references: [id])
  order              Order                    @relation(fields: [orderId], references: [id])
  templateDescriptor PromptTemplateDescriptor @relation(fields: [templateDescriptorId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, templateDescriptorId])
  @@map("library_entry")
}
