generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String                   @default("NO_NAME") @db.VarChar(250)
  email                     String                   @unique(map: "user_email_idx") @db.VarChar(250)
  emailVerified             DateTime?                @map("email_verified") @db.Timestamp(6)
  image                     String?
  password                  String?                  @db.VarChar(250)
  role                      String                   @default("user") @db.VarChar(50)
  stripeCustomerId          String?                  @unique @map("stripe_customer_id") @db.VarChar(250)
  legalNoticesAcceptedAt    DateTime?                @map("legal_notices_accepted_at") @db.Timestamp(6)
  iubendaLegalNoticesSynced Boolean                  @default(false) @map("iubenda_legal_notices_synced")
  trialEndsAt               DateTime?                @map("trial_ends_at") @db.Timestamp(6)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  accounts                  Account[]
  sessions                  Session[]
  carts                     Cart[]
  orders                    Order[]
  libraryCollections        LibraryCollection[]
  libraryCollectionEntries  LibraryCollectionEntry[]
  subscription              Subscription?
  subscriptionHistory       SubscriptionHistory[]
  globalPromptFields        GlobalPromptField[]
  promptDescriptors         Prompt0[]
  promptCategories          Prompt0Category[]
  promptTemplateCategories  PromptCategory[]
  prompts                   Prompt[]
  workflows                 Workflow[]

  @@map("user")
}

model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(250)
  provider          String  @db.VarChar(500)
  providerAccountId String  @map("provider_account_id") @db.VarChar(500)
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type") @db.VarChar(250)
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

model PasswordResetToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("password_reset_token")
}

model Prompt0 {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  title            String            @db.VarChar(500)
  content          String            @db.Text
  categories       Prompt0Category[]
  recommendedModel String            @map("recommended_model") @db.VarChar(250)
  isFavorite       Boolean           @default(false) @map("is_favorite")
  currentVersion   Int               @default(0) @map("current_version")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt0Content   Prompt0Content?
  versions         Prompt0Version[]
  followUpPrompts  Prompt0FollowUp[]

  @@index([userId])
  @@map("prompt0")
}

model Prompt0Content {
  id         String  @id @db.Uuid
  content    String  @db.Text
  descriptor Prompt0 @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("prompt0_content")
}

model Prompt0Category {
  id      Int       @id @default(autoincrement())
  userId  String    @map("user_id") @db.Uuid
  name    String    @db.VarChar(250)
  prompts Prompt0[]
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("prompt0_category")
}

model Prompt0Version {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId  String   @map("prompt_id") @db.Uuid
  content   String   @db.Text
  version   Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  prompt    Prompt0  @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt0_version")
}

model Prompt0FollowUp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId  String   @map("prompt_id") @db.Uuid
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  prompt    Prompt0  @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("prompt0_follow_up")
}

model Prompt {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  title            String           @db.VarChar(250)
  description      String           @db.VarChar(750)
  categories       PromptCategory[]
  recommendedModel String           @map("recommended_model") @db.VarChar(250)
  isFavorite       Boolean          @default(false) @map("is_favorite")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content           PromptContent?
  fields            PromptField[]
  globalFields      PromptGlobalField[]
  productItems      ProductItem[]
  collectionEntries LibraryCollectionEntry[]
  workflowSteps     WorkflowStep[]

  @@index([userId])
  @@map("prompt")
}

model PromptContent {
  promptId String @id @map("prompt_id") @db.Uuid
  content  String @map("content") @db.Text

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@map("prompt_content")
}

model PromptGlobalField {
  promptId      String @map("prompt_id") @db.Uuid
  globalFieldId String @map("global_field_id") @db.Uuid
  order         Int    @default(0)

  prompt      Prompt            @relation(fields: [promptId], references: [id], onDelete: Cascade)
  globalField GlobalPromptField @relation(fields: [globalFieldId], references: [id])

  @@id([promptId, globalFieldId])
  @@index([promptId])
  @@map("prompt_global_field")
}

model PromptField {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId     String          @map("prompt_id") @db.Uuid
  name         String          @db.VarChar(100)
  label        String          @db.VarChar(250)
  description  String?         @db.VarChar(500)
  type         PromptFieldType
  required     Boolean         @default(true)
  order        Int             @default(0)
  defaultValue String?         @map("default_value") @db.Text
  options      Json?           @db.JsonB

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, name])
  @@index([promptId])
  @@map("prompt_field")
}

enum PromptFieldType {
  TEXT
  TEXTAREA
  EMAIL
  NUMBER
  DATE
  SELECT
  CHECKBOX
  RADIO

  @@map("prompt_field_type")
}

model PromptCategory {
  id      Int      @id @default(autoincrement())
  userId  String   @map("user_id") @db.Uuid
  name    String   @db.VarChar(250)
  prompts Prompt[]
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("prompt_category")
}

model GlobalPromptField {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  name         String              @db.VarChar(100)
  label        String              @db.VarChar(250)
  description  String?             @db.VarChar(500)
  type         PromptFieldType
  required     Boolean             @default(true)
  defaultValue String?             @map("default_value") @db.Text
  options      Json?               @db.JsonB
  order        Int                 @default(0)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompts      PromptGlobalField[]

  @@unique([userId, name])
  @@index([userId])
  @@map("global_field")
}

model LibraryCollection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(250)
  description String?  @db.VarChar(750)
  color       String?  @db.VarChar(50)
  order       Int      @default(0)
  isPublic    Boolean  @default(false) @map("is_public")
  publicToken String?  @unique @map("public_token") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LibraryCollectionEntry[]

  @@unique([userId, name])
  @@index([userId])
  @@map("library_collection")
}

model LibraryCollectionEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  promptId     String   @map("prompt_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamp(6)

  collection LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  prompt     Prompt            @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, promptId])
  @@index([collectionId])
  @@index([promptId])
  @@map("library_collection_entry")
}

// E-Commerce Models

enum ProductType {
  TEMPLATE
  BUNDLE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Subscription Models

enum SubscriptionTier {
  FREE
  BASIC
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  PAST_DUE
  UNPAID
  TRIALING
  PAUSED
}

model Product {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String               @db.VarChar(250)
  description    String               @db.Text
  price          Decimal              @db.Decimal(10, 2)
  discountAmount Decimal?             @map("discount_amount") @db.Decimal(10, 2)
  type           ProductType
  status         ProductStatus        @default(ACTIVE)
  features       ProductFeature[]
  useCases       ProductUseCase[]
  examples       ProductExample[]
  instructions   ProductInstruction[]
  productItems   ProductItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@map("product")
}

model ProductFeature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  icon        String   @db.VarChar(50)
  title       String   @db.VarChar(250)
  description String   @db.VarChar(750)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_feature")
}

model ProductUseCase {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  category    String   @db.VarChar(250)
  description String   @db.VarChar(750)
  tags        String[] @db.VarChar(100)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_use_case")
}

model ProductExample {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  title     String   @db.VarChar(250)
  content   String   @db.VarChar(750)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_example")
}

model ProductInstruction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  step        Int
  title       String   @db.VarChar(250)
  description String   @db.VarChar(750)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_instruction")
}

model ProductItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product  Product @relation(fields: [productId], references: [id])
  template Prompt  @relation(fields: [templateId], references: [id])

  @@unique([productId, templateId])
  @@map("product_item")
}

model Cart {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  sessionCartId String?    @unique @map("session_cart_id") @db.VarChar(250)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @map("updated_at")
  items         CartItem[]
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart")
}

model CartItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId             String      @map("cart_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productName        String      @map("product_name") @db.VarChar(250)
  productDescription String?     @map("product_description") @db.VarChar(500)
  productType        ProductType @map("product_type")
  productPrice       Decimal     @map("product_price") @db.Decimal(10, 2)
  quantity           Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime    @updatedAt @map("updated_at")
  product            Product     @relation(fields: [productId], references: [id])
  cart               Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_item")
}

model Order {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String      @map("user_id") @db.Uuid
  status                  OrderStatus @default(PENDING)
  totalAmount             Decimal     @map("total_amount") @db.Decimal(10, 2)
  paymentMethod           String?     @map("payment_method") @db.VarChar(100)
  stripeCheckoutSessionId String?     @unique @map("stripe_checkout_session_id") @db.VarChar(500)
  stripePaymentIntentId   String?     @map("stripe_payment_intent_id") @db.VarChar(500)
  stripePaymentStatus     String?     @map("stripe_payment_status") @db.VarChar(50)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime    @updatedAt @map("updated_at")
  user                    User        @relation(fields: [userId], references: [id])
  items                   OrderItem[]

  @@map("order")
}

model OrderItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String      @map("order_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productName        String      @map("product_name") @db.VarChar(250)
  productDescription String?     @map("product_description") @db.VarChar(500)
  productType        ProductType @map("product_type")
  quantity           Int         @default(1)
  price              Decimal     @db.Decimal(10, 2)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [productId], references: [id])

  @@map("order_item")
}

model SubscriptionPlan {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier                 SubscriptionTier @unique
  name                 String           @db.VarChar(100)
  description          String           @db.Text
  monthlyPrice         Decimal          @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice          Decimal          @map("yearly_price") @db.Decimal(10, 2)
  stripePriceIdMonthly String?          @map("stripe_price_id_monthly") @db.VarChar(250)
  stripePriceIdYearly  String?          @map("stripe_price_id_yearly") @db.VarChar(250)
  stripeProductId      String?          @map("stripe_product_id") @db.VarChar(250)
  features             Json             @db.JsonB
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime         @updatedAt @map("updated_at")
  subscriptions        Subscription[]

  @@map("subscription_plan")
}

model Subscription {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String             @unique @map("user_id") @db.Uuid
  planId                  String             @map("plan_id") @db.Uuid
  status                  SubscriptionStatus @default(INCOMPLETE)
  billingInterval         BillingInterval    @map("billing_interval")
  stripeSubscriptionId    String?            @unique @map("stripe_subscription_id") @db.VarChar(250)
  stripeCustomerId        String?            @map("stripe_customer_id") @db.VarChar(250)
  stripeCheckoutSessionId String?            @unique @map("stripe_checkout_session_id") @db.VarChar(250)
  currentPeriodStart      DateTime?          @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd        DateTime?          @map("current_period_end") @db.Timestamp(6)
  cancelAtPeriodEnd       Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt              DateTime?          @map("canceled_at") @db.Timestamp(6)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime           @updatedAt @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
  @@map("subscription")
}

// Catalog / Explore Domain

model CatalogCategory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @unique @db.VarChar(250)
  slug        String         @unique @db.VarChar(250)
  description String?        @db.VarChar(500)
  order       Int            @default(0)
  entries     CatalogEntry[]
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("catalog_category")
}

enum CatalogEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("catalog_entry_status")
}

model CatalogEntry {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String             @unique @db.VarChar(250)
  title            String             @db.VarChar(250)
  description      String             @db.VarChar(750)
  recommendedModel String             @map("recommended_model") @db.VarChar(250)
  status           CatalogEntryStatus @default(DRAFT)
  categoryId       String?            @map("category_id") @db.Uuid
  copyCount        Int                @default(0) @map("copy_count")
  publishedAt      DateTime?          @map("published_at") @db.Timestamp(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime           @updatedAt @map("updated_at")

  category CatalogCategory?     @relation(fields: [categoryId], references: [id])
  fields   CatalogEntryField[]
  content  CatalogEntryContent?

  @@index([status])
  @@index([categoryId])
  @@map("catalog_entry")
}

model CatalogEntryContent {
  catalogEntryId String @id @map("catalog_entry_id") @db.Uuid
  content        String @db.Text

  catalogEntry CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@map("catalog_entry_content")
}

model CatalogEntryField {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogEntryId String          @map("catalog_entry_id") @db.Uuid
  name           String          @db.VarChar(100)
  label          String          @db.VarChar(250)
  description    String?         @db.VarChar(500)
  type           PromptFieldType
  required       Boolean         @default(true)
  order          Int             @default(0)
  defaultValue   String?         @map("default_value") @db.Text
  options        Json?           @db.JsonB

  catalogEntry CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@unique([catalogEntryId, name])
  @@index([catalogEntryId])
  @@map("catalog_entry_field")
}

model SubscriptionHistory {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  eventType     String              @map("event_type") @db.VarChar(50)
  fromTier      SubscriptionTier?   @map("from_tier")
  toTier        SubscriptionTier?   @map("to_tier")
  fromStatus    SubscriptionStatus? @map("from_status")
  toStatus      SubscriptionStatus? @map("to_status")
  stripeEventId String?             @map("stripe_event_id") @db.VarChar(250)
  metadata      Json?               @db.JsonB
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeEventId])
  @@map("subscription_history")
}

// Workflow Models

enum WorkflowStepType {
  PROMPT_REF
  STANDALONE

  @@map("workflow_step_type")
}

model Workflow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(250)
  description String?  @db.VarChar(750)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps WorkflowStep[]

  @@index([userId])
  @@map("workflow")
}

model WorkflowStep {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String           @map("workflow_id") @db.Uuid
  title      String           @db.VarChar(250)
  hint       String?          @db.VarChar(750)
  type       WorkflowStepType
  promptId   String?          @map("prompt_id") @db.Uuid
  content    String?          @db.Text
  edgeId     String           @map("edge_id") @db.Uuid
  isStart    Boolean          @default(false) @map("is_start")
  position   Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime         @updatedAt @map("updated_at")

  workflow      Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  prompt        Prompt?            @relation(fields: [promptId], references: [id], onDelete: SetNull)
  outgoingEdges WorkflowStepEdge[] @relation("EdgeFrom")
  incomingEdges WorkflowStepEdge[] @relation("EdgeTo")

  @@index([workflowId])
  @@map("workflow_step")
}

model WorkflowStepEdge {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromStepId String   @map("from_step_id") @db.Uuid
  toStepId   String   @map("to_step_id") @db.Uuid
  label      String   @db.VarChar(250)
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  fromStep WorkflowStep @relation("EdgeFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep   WorkflowStep @relation("EdgeTo", fields: [toStepId], references: [id], onDelete: Cascade)

  @@unique([fromStepId, toStepId])
  @@index([fromStepId])
  @@index([toStepId])
  @@map("workflow_step_edge")
}
