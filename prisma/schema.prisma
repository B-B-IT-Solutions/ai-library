generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                @default("NO_NAME") @db.VarChar(250)
  email                String                @unique(map: "user_email_idx") @db.VarChar(250)
  emailVerified        DateTime?             @map("email_verified") @db.Timestamp(6)
  image                String?
  password             String?               @db.VarChar(250)
  role                 String                @default("user") @db.VarChar(50)
  stripeCustomerId     String?               @unique @map("stripe_customer_id") @db.VarChar(250)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime              @updatedAt @map("updated_at")
  accounts             Account[]
  sessions             Session[]
  carts                Cart[]
  orders               Order[]
  libraries            LibraryEntry[]
  libraryCollections   LibraryCollection[]
  subscription         Subscription?
  subscriptionHistory  SubscriptionHistory[]
  globalTemplateFields GlobalTemplateField[]

  @@map("user")
}

model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(250)
  provider          String  @db.VarChar(500)
  providerAccountId String  @map("provider_account_id") @db.VarChar(500)
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type") @db.VarChar(250)
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

model PromptDescriptor {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String           @db.VarChar(500)
  content          String           @db.Text
  categories       PromptCategory[]
  recommendedModel String           @map("recommended_model") @db.VarChar(250)
  isFavorite       Boolean          @default(false) @map("is_favorite")
  currentVersion   Int              @default(0) @map("current_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime         @updatedAt @map("updated_at")
  prompt           Prompt?
  versions         PromptVersion[]
  followUpPrompts  PromptFollowUp[]

  @@map("prompt_descriptor")
}

model Prompt {
  id         String           @id @db.Uuid
  content    String           @db.Text
  descriptor PromptDescriptor @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("prompt")
}

model PromptCategory {
  id      Int                @id @default(autoincrement())
  name    String             @unique @db.VarChar(250)
  prompts PromptDescriptor[]

  @@map("prompt_category")
}

model PromptVersion {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId  String           @map("prompt_id") @db.Uuid
  content   String           @db.Text
  version   Int
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  prompt    PromptDescriptor @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_version")
}

model PromptFollowUp {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId  String           @map("prompt_id") @db.Uuid
  content   String           @db.Text
  order     Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  prompt    PromptDescriptor @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("prompt_follow_up")
}

model PromptTemplateDescriptor {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String                   @db.VarChar(250)
  description      String                   @db.VarChar(750)
  categories       PromptTemplateCategory[]
  recommendedModel String                   @map("recommended_model") @db.VarChar(250)
  promptTemplateId String                   @unique @map("prompt_template_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  promptTemplate PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  productItems   ProductItem[]
  libraries      LibraryEntry[]

  @@map("prompt_template_descriptor")
}

model PromptTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String   @map("content") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at")

  promptTemplateDescriptor PromptTemplateDescriptor?
  fields                   PromptTemplateField[]
  globalFields             PromptTemplateGlobalField[]

  @@map("prompt_template")
}

model PromptTemplateGlobalField {
  promptTemplateId String @map("prompt_template_id") @db.Uuid
  globalFieldId    String @map("global_field_id") @db.Uuid
  order            Int    @default(0)

  promptTemplate PromptTemplate      @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  globalField    GlobalTemplateField @relation(fields: [globalFieldId], references: [id])

  @@id([promptTemplateId, globalFieldId])
  @@index([promptTemplateId])
  @@map("prompt_template_global_field")
}

model PromptTemplateField {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptTemplateId String                  @map("prompt_template_id") @db.Uuid
  name             String                  @db.VarChar(100)
  label            String                  @db.VarChar(250)
  description      String?                 @db.VarChar(500)
  type             PromptTemplateFieldType
  required         Boolean                 @default(true)
  order            Int                     @default(0)
  defaultValue     String?                 @map("default_value") @db.Text
  options          Json?                   @db.JsonB

  promptTemplate PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@unique([promptTemplateId, name])
  @@index([promptTemplateId])
  @@map("prompt_template_field")
}

enum PromptTemplateFieldType {
  TEXT
  TEXTAREA
  EMAIL
  NUMBER
  DATE
  SELECT
  CHECKBOX
  RADIO

  @@map("prompt_template_field_type")
}

model PromptTemplateCategory {
  id        Int                        @id @default(autoincrement())
  name      String                     @unique @db.VarChar(250)
  templates PromptTemplateDescriptor[]

  @@map("prompt_template_category")
}

model GlobalTemplateField {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                      @map("user_id") @db.Uuid
  name            String                      @db.VarChar(100)
  label           String                      @db.VarChar(250)
  description     String?                     @db.VarChar(500)
  type            PromptTemplateFieldType
  required        Boolean                     @default(true)
  defaultValue    String?                     @map("default_value") @db.Text
  options         Json?                       @db.JsonB
  order           Int                         @default(0)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptTemplates PromptTemplateGlobalField[]

  @@unique([userId, name])
  @@index([userId])
  @@map("global_field")
}

model LibraryEntry {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  templateDescriptorId String   @map("template_descriptor_id") @db.Uuid
  isFavorite           Boolean  @default(false) @map("is_favorite")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateDescriptor PromptTemplateDescriptor @relation(fields: [templateDescriptorId], references: [id], onDelete: Cascade)
  collectionEntries  LibraryCollectionEntry[]

  @@unique([userId, templateDescriptorId])
  @@index([userId, isFavorite])
  @@map("library_entry")
}

model LibraryCollection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(250)
  description String?  @db.VarChar(750)
  color       String?  @db.VarChar(50)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LibraryCollectionEntry[]

  @@unique([userId, name])
  @@index([userId])
  @@map("library_collection")
}

model LibraryCollectionEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  entryId      String   @map("entry_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamp(6)

  collection LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entry      LibraryEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([collectionId, entryId])
  @@index([collectionId])
  @@index([entryId])
  @@map("library_collection_entry")
}

// E-Commerce Models

enum ProductType {
  TEMPLATE
  BUNDLE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Subscription Models

enum SubscriptionTier {
  FREE
  BASIC
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  PAST_DUE
  UNPAID
  TRIALING
  PAUSED
}

model Product {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String               @db.VarChar(250)
  description    String               @db.Text
  price          Decimal              @db.Decimal(10, 2)
  discountAmount Decimal?             @map("discount_amount") @db.Decimal(10, 2)
  type           ProductType
  status         ProductStatus        @default(ACTIVE)
  features       ProductFeature[]
  useCases       ProductUseCase[]
  examples       ProductExample[]
  instructions   ProductInstruction[]
  productItems   ProductItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@map("product")
}

model ProductFeature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  icon        String   @db.VarChar(50)
  title       String   @db.VarChar(250)
  description String   @db.VarChar(750)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_feature")
}

model ProductUseCase {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  category    String   @db.VarChar(250)
  description String   @db.VarChar(750)
  tags        String[] @db.VarChar(100)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_use_case")
}

model ProductExample {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  title     String   @db.VarChar(250)
  content   String   @db.VarChar(750)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_example")
}

model ProductInstruction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  step        Int
  title       String   @db.VarChar(250)
  description String   @db.VarChar(750)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_instruction")
}

model ProductItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product  Product                  @relation(fields: [productId], references: [id])
  template PromptTemplateDescriptor @relation(fields: [templateId], references: [id])

  @@unique([productId, templateId])
  @@map("product_item")
}

model Cart {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  sessionCartId String?    @unique @map("session_cart_id") @db.VarChar(250)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @map("updated_at")
  items         CartItem[]
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart")
}

model CartItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId             String      @map("cart_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productName        String      @map("product_name") @db.VarChar(250)
  productDescription String?     @map("product_description") @db.VarChar(500)
  productType        ProductType @map("product_type")
  productPrice       Decimal     @map("product_price") @db.Decimal(10, 2)
  quantity           Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime    @updatedAt @map("updated_at")
  product            Product     @relation(fields: [productId], references: [id])
  cart               Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_item")
}

model Order {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String      @map("user_id") @db.Uuid
  status                  OrderStatus @default(PENDING)
  totalAmount             Decimal     @map("total_amount") @db.Decimal(10, 2)
  paymentMethod           String?     @map("payment_method") @db.VarChar(100)
  stripeCheckoutSessionId String?     @unique @map("stripe_checkout_session_id") @db.VarChar(500)
  stripePaymentIntentId   String?     @map("stripe_payment_intent_id") @db.VarChar(500)
  stripePaymentStatus     String?     @map("stripe_payment_status") @db.VarChar(50)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime    @updatedAt @map("updated_at")
  user                    User        @relation(fields: [userId], references: [id])
  items                   OrderItem[]

  @@map("order")
}

model OrderItem {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String      @map("order_id") @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  productName        String      @map("product_name") @db.VarChar(250)
  productDescription String?     @map("product_description") @db.VarChar(500)
  productType        ProductType @map("product_type")
  quantity           Int         @default(1)
  price              Decimal     @db.Decimal(10, 2)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [productId], references: [id])

  @@map("order_item")
}

model SubscriptionPlan {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier                 SubscriptionTier @unique
  name                 String           @db.VarChar(100)
  description          String           @db.Text
  monthlyPrice         Decimal          @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice          Decimal          @map("yearly_price") @db.Decimal(10, 2)
  stripePriceIdMonthly String?          @map("stripe_price_id_monthly") @db.VarChar(250)
  stripePriceIdYearly  String?          @map("stripe_price_id_yearly") @db.VarChar(250)
  stripeProductId      String?          @map("stripe_product_id") @db.VarChar(250)
  features             Json             @db.JsonB
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime         @updatedAt @map("updated_at")
  subscriptions        Subscription[]

  @@map("subscription_plan")
}

model Subscription {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String             @unique @map("user_id") @db.Uuid
  planId                  String             @map("plan_id") @db.Uuid
  status                  SubscriptionStatus @default(INCOMPLETE)
  billingInterval         BillingInterval    @map("billing_interval")
  stripeSubscriptionId    String?            @unique @map("stripe_subscription_id") @db.VarChar(250)
  stripeCustomerId        String?            @map("stripe_customer_id") @db.VarChar(250)
  stripeCheckoutSessionId String?            @unique @map("stripe_checkout_session_id") @db.VarChar(250)
  currentPeriodStart      DateTime?          @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd        DateTime?          @map("current_period_end") @db.Timestamp(6)
  cancelAtPeriodEnd       Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt              DateTime?          @map("canceled_at") @db.Timestamp(6)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime           @updatedAt @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([stripeSubscriptionId])
  @@index([stripeCheckoutSessionId])
  @@map("subscription")
}

model SubscriptionHistory {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  eventType     String              @map("event_type") @db.VarChar(50)
  fromTier      SubscriptionTier?   @map("from_tier")
  toTier        SubscriptionTier?   @map("to_tier")
  fromStatus    SubscriptionStatus? @map("from_status")
  toStatus      SubscriptionStatus? @map("to_status")
  stripeEventId String?             @map("stripe_event_id") @db.VarChar(250)
  metadata      Json?               @db.JsonB
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeEventId])
  @@map("subscription_history")
}
