          >
            <rect
              height="14"
              rx="2"
              ry="2"
              width="14"
              x="8"
              y="8"
            />
            <path
              d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            />
          </svg>
          <span>
            Kopieren
          </span>
        </button>
        <div
          data-slot="tooltip-content"
          data-testid="mock-tooltip-content"
          sideoffset="0"
        >
          In Zwischenablage kopieren
        </div>
        <div
          data-slot="dropdown-menu"
          data-testid="mock-react-dropdown-menu-root"
        >
          <button
            data-slot="dropdown-menu-trigger"
            data-testid="open-in-ai-btn"
            type="button"
          >
            In KI öffnen
            <svg
              aria-hidden="true"
              class="lucide lucide-chevron-down h-3.5 w-3.5 opacity-70"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m6 9 6 6 6-6"
              />
            </svg>
          </button>
          <div
            data-testid="mock-react-dropdown-menu-portal"
          />
        </div>
      </div>
    </div>
  </form>
</div>
`;

