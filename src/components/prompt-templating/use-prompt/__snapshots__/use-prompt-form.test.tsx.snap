              class="text-xs text-muted-foreground"
            >
              <span
                class="mr-1 inline-block rounded bg-orange-100 px-1 text-orange-700 italic"
              >
                {{platzhalter}}
              </span>
              noch nicht ausgefüllt ·
               
              <span
                class="mr-1 inline-block rounded bg-green-100 px-1 font-medium text-green-800"
              >
                wert
              </span>
              ausgefüllt
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      class="relative flex shrink-0 items-center justify-between gap-2 bg-background px-6 py-4"
    >
      <div
        class="pointer-events-none absolute inset-x-0 -top-8 h-8"
        style="background: linear-gradient(to bottom, transparent, hsl(var(--background)));"
      />
      <p
        class="text-xs text-muted-foreground"
        data-testid="required-fields-progress"
      >
        0
         von 
        3
         
        Pflichtplatzhalter
        n
         ausgefüllt
      </p>
      <div
        class="flex items-center gap-2"
      >
        <button
          data-slot="tooltip-trigger"
          data-testid="copy-prompt-btn"
          type="submit"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-copy"
            data-testid="copy-icon"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
